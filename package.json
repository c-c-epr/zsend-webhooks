{
  "name": "zsend-webhooks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prestart": "wrangler types",
    "start": "wrangler dev -e .env",
    "predev": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:run": "vitest run",
    "cf-typegen": "wrangler types",
    "types": "wrangler types",
    "types:sync": "wrangler types",
    "types:check": "pnpm run types:sync && git diff --exit-code -- worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@12.14.0"
}
